{
  "name": "world-cup-2026-jersey-store",
  "version": "1.0.0",
  "private": true,
  "description": "Responsive 2026 world football fan jersey storefront with Express, PostgreSQL and Docker.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env --watch server.js",
